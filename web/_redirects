# The download button's canonical path. Points at GitHub Releases rather than a
# file in this repo: Pages caps single files at 25 MiB, and a committed binary
# would stay in git history permanently.
/download   https://github.com/TouchBitsInc/easy-sweep-mac/releases/latest/download/EasySweep.dmg   302
/dmg        https://github.com/TouchBitsInc/easy-sweep-mac/releases/latest/download/EasySweep.dmg   302

# Pages serves HTML extensionless and 308s /foo.html -> /foo. So an alias must
# point AT the extensionless URL; pointing /support -> /support.html builds an
# infinite loop with that canonicalisation and takes the page off the internet.
/help       /support        301
